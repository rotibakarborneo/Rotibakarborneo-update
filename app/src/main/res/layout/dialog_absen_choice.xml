<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Konfirmasi Presensi"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChoiceMasuk"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="ABSEN MASUK"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/primary_green" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChoicePulang"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="ABSEN PULANG"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/status_closed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChoiceBatal"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="BATAL"
        android:textColor="@color/text_secondary"
        app:cornerRadius="16dp" />

</LinearLayout>