        <activity android:name=".ui.admin.KaryawanFormActivity" android:exported="false" />
        <service android:name=".notification.BorneoMessagingService" android:exported="false"><intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter></service>

        <activity
